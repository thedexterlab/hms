# XAMPP ships MariaDB. Start Apache Friends → MySQL from the XAMPP control
# panel (default: 127.0.0.1:3306, user "root" with an empty password), then
# create the database once:
#   mysql -u root -e "CREATE DATABASE IF NOT EXISTS hms CHARACTER SET utf8mb4;"
# Supply the connection string to the ASP.NET process as ConnectionStrings__Hms,
# e.g. ConnectionStrings__Hms="Server=127.0.0.1;Port=3306;Database=hms;User=root;Password="

