# Copy to .env.development / .env.local as needed.
#
# SECURITY: gates the hard-coded demo login accounts (plaintext passwords in
# src/auth.service.ts). Leave unset/false in any build touching real data —
# real authentication must come from the backend identity service.
VITE_USE_MOCK_AUTH=false

# Base URL of the hospital API (when the backend exists).
VITE_API_BASE_URL=/api

# To use the ASP.NET backend during local development, set mock auth to false
# and point this URL at the API launch profile:
# VITE_USE_MOCK_AUTH=false
# VITE_API_BASE_URL=http://localhost:5127/api
